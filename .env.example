PORT=3456
SITE_URL=https://spisehusetgaarden.vercel.app

# Stripe TEST
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

BOOKING_DEPOSIT_DKK=50
# Deposit per person (total = BOOKING_DEPOSIT_DKK × number of guests)
BOOKING_MAX_MONTHS_AHEAD=6
BOOKING_NOTIFY_EMAIL=info@spisehusetgaarden.dk

# Email — one.com SMTP (site is not hosted at one.com, so use send.one.com)
SMTP_HOST=send.one.com
SMTP_PORT=587
SMTP_USER=booking@spisehusetgaarden.dk
SMTP_PASS=
SMTP_FROM=Spisehuset Gaarden <booking@spisehusetgaarden.dk>

# Optional fallback if SMTP is not set
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Spisehuset Gaarden <booking@spisehusetgaarden.dk>

BLOB_READ_WRITE_TOKEN=

# Required on Vercel for bookings, capacity/blackout dates, and admin uploads
